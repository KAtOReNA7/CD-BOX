{
  "name": "cd-box-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run lint",
    "audit:prod": "npm audit --omit=dev",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "test:import": "tsx --conditions=react-server tests/import-parser.test.ts && tsx --conditions=react-server tests/import-real-template.test.ts && tsx --conditions=react-server tests/release-research-parser.test.ts && tsx --conditions=react-server tests/release-research-quality.test.ts && tsx --conditions=react-server tests/release-structure-parser.test.ts && tsx --conditions=react-server tests/release-structure-real-fixture.test.ts && tsx --conditions=react-server tests/ai-provider-config.test.ts && tsx --conditions=react-server tests/release-library-filter.test.ts && tsx --conditions=react-server tests/release-library-stats.test.ts && tsx --conditions=react-server tests/release-export.test.ts && tsx --conditions=react-server tests/release-bulk-validation.test.ts",
    "smoke:pasted-structure": "tsx scripts/smoke-pasted-structure.mjs",
    "probe:ai": "node scripts/probe-ai-provider.mjs",
    "smoke:real-import": "tsx scripts/smoke-real-excel-import.mjs",
    "smoke:real-ai-search": "tsx scripts/smoke-real-ai-search.mjs",
    "sample:excel": "node scripts/create-sample-excel.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/oidc": "^3.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "^4.24.14",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "hono": "4.12.29",
    "postcss": "8.5.16",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
