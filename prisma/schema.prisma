generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReleaseCategory {
  ORIGINAL_ALBUM
  SINGLE
  BEST
  COLLECTION
  COMPILATION
  LIVE
  REMIX
  BOX
  EP
  OTHER
}

enum CollectionStatus {
  WANTED
  OWNED
  NOT_OWNED
  EXCLUDED
  PENDING_REVIEW
}

enum ReleaseFormat {
  CD
  SHM_CD
  BLU_SPEC_CD
  SACD
  HYBRID_SACD
  CD_DVD
  BOX_SET
  OTHER
}

enum ImportBatchStatus {
  DRAFT
  IMPORTED
  FAILED
}

enum AiSearchTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ReleaseVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum DatePrecision {
  YEAR
  MONTH
  DAY
}

enum ReleaseWorkStatus {
  DISCOVERED
  CORROBORATED
  VERIFIED
  CONFLICTED
  REJECTED
}

enum ResearchEntityKind {
  WORK
  EDITION
}

enum ResearchDisposition {
  DISCOVERED
  ACTIVE
  DEFERRED
  ACCEPTED
  REJECTED
  MERGED
}

enum ResearchDecisionOutcome {
  PASS
  DEFER
  REJECT
  MERGE
  RETRY
  ERROR
}

enum CoverStatus {
  MISSING
  QUEUED
  CHECKING
  RETRY_WAIT
  VALID
  INVALID
  EXHAUSTED
}

enum UiAssetKind {
  EMPTY_STATE
  DECORATION
  PLACEHOLDER
}

model User {
  id            String              @id @default(cuid())
  name          String?
  email         String?             @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  followed      UserArtistFollow[]
  releaseStatus UserReleaseStatus[]
  importBatches ImportBatch[]
  aiSearchTasks AiSearchTask[]
  uiAssets      UiAsset[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Artist {
  id            String             @id @default(cuid())
  name          String
  sortName      String?
  country       String?
  description   String?            @db.Text
  follows       UserArtistFollow[]
  releaseWorks  ReleaseWork[]
  releases      Release[]
  importBatches ImportBatch[]
  aiSearchTasks AiSearchTask[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([name])
}

model UserArtistFollow {
  id        String   @id @default(cuid())
  userId    String
  artistId  String
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@index([artistId])
}

model Release {
  id                    String                    @id @default(cuid())
  artistId              String
  workId                String?
  category              ReleaseCategory
  title                 String
  originalReleaseDate   DateTime?
  editionReleaseDate    DateTime?
  editionDatePrecision  DatePrecision?
  format                ReleaseFormat             @default(CD)
  originalCatalogNo     String?
  musicBrainzReleaseId  String?                   @unique
  discogsReleaseId      Int?                      @unique
  barcode               String?
  label                 String?
  originalPrice         String?
  editionType           String?
  isReissue             Boolean                   @default(false)
  isRemaster            Boolean                   @default(false)
  isExcludedByDefault   Boolean                   @default(false)
  confidence            String?
  warnings              Json?
  notes                 String?                   @db.Text
  coverImageUrl         String?                   @db.Text
  coverImageSourceUrl   String?                   @db.Text
  coverStatus           CoverStatus               @default(MISSING)
  coverProvider         String?
  coverCheckedAt        DateTime?
  coverAttemptCount     Int                       @default(0)
  coverNextRetryAt      DateTime?
  coverLastErrorCode    String?
  coverLastErrorMessage String?                   @db.Text
  verificationStatus    ReleaseVerificationStatus @default(UNVERIFIED)
  verificationEvidence  Json?
  verifiedAt            DateTime?
  sources               ReleaseSource[]
  researchCandidates    ResearchCandidate[]
  userStatus            UserReleaseStatus[]
  artist                Artist                    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  work                  ReleaseWork?              @relation(fields: [workId], references: [id], onDelete: SetNull)
  importBatchId         String?
  importBatch           ImportBatch?              @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([artistId, category])
  @@index([artistId, verificationStatus])
  @@index([artistId, originalCatalogNo])
  @@index([workId, editionReleaseDate])
  @@index([coverStatus, coverNextRetryAt])
  @@index([importBatchId])
  @@index([title])
}

model ReleaseWork {
  id                        String              @id @default(cuid())
  artistId                  String
  title                     String
  titleOriginal             String?
  artistCredit              String?
  category                  ReleaseCategory
  originalReleaseDate       DateTime?
  originalDatePrecision     DatePrecision?
  musicBrainzReleaseGroupId String?             @unique
  verificationStatus        ReleaseWorkStatus   @default(DISCOVERED)
  verificationEvidence      Json?
  verifiedAt                DateTime?
  artist                    Artist              @relation(fields: [artistId], references: [id], onDelete: Cascade)
  editions                  Release[]
  sources                   ReleaseWorkSource[]
  researchCandidates        ResearchCandidate[]
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@index([artistId, category, originalReleaseDate])
  @@index([artistId, verificationStatus])
}

model ReleaseWorkSource {
  id         String      @id @default(cuid())
  workId     String
  provider   String
  role       String
  externalId String?
  url        String      @db.Text
  label      String?
  observed   Json?
  work       ReleaseWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([workId, role])
  @@index([provider, externalId])
}

model ReleaseSource {
  id          String   @id @default(cuid())
  releaseId   String
  url         String   @db.Text
  label       String?
  description String?  @db.Text
  release     Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([releaseId])
}

model UserReleaseStatus {
  id             String           @id @default(cuid())
  userId         String
  releaseId      String
  status         CollectionStatus @default(NOT_OWNED)
  priority       Int              @default(3)
  ownedCondition String?
  ownedNotes     String?          @db.Text
  notes          String?          @db.Text
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  release        Release          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, releaseId])
  @@index([userId, status])
  @@index([releaseId])
}

model ImportBatch {
  id         String            @id @default(cuid())
  userId     String
  artistId   String?
  fileName   String?
  sourceType String            @default("excel")
  status     ImportBatchStatus @default(DRAFT)
  rowCount   Int               @default(0)
  errorJson  Json?
  importedAt DateTime?
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist     Artist?           @relation(fields: [artistId], references: [id], onDelete: SetNull)
  releases   Release[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
  @@index([artistId])
}

model AiSearchTask {
  id                  String                 @id @default(cuid())
  userId              String
  artistId            String?
  query               String                 @db.Text
  request             Json?
  model               String
  pipelineVersion     String                 @default("legacy")
  resultSchemaVersion Int                    @default(1)
  status              AiSearchTaskStatus     @default(QUEUED)
  progress            Int                    @default(0)
  stage               String?
  rawResult           Json?
  parsedResult        Json?
  errorMessage        String?                @db.Text
  startedAt           DateTime?
  completedAt         DateTime?
  importedAt          DateTime?
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist              Artist?                @relation(fields: [artistId], references: [id], onDelete: SetNull)
  candidates          ResearchCandidate[]
  stageSummaries      ResearchStageSummary[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([userId])
  @@index([artistId])
}

model ResearchCandidate {
  id                    String              @id @default(cuid())
  taskId                String
  candidateKey          String
  entityKind            ResearchEntityKind
  parentCandidateId     String?
  workId                String?
  releaseId             String?
  sourceProvider        String?
  sourceRecordId        String?
  title                 String
  category              ReleaseCategory?
  artistCredit          String?
  releaseDate           DateTime?
  datePrecision         DatePrecision?
  catalogNumber         String?
  barcode               String?
  payload               Json?
  disposition           ResearchDisposition @default(DISCOVERED)
  lastStage             String?
  finalReasonCode       String?
  retryable             Boolean             @default(false)
  coverImageUrl         String?             @db.Text
  coverImageSourceUrl   String?             @db.Text
  coverStatus           CoverStatus         @default(MISSING)
  coverProvider         String?
  coverCheckedAt        DateTime?
  coverAttemptCount     Int                 @default(0)
  coverNextRetryAt      DateTime?
  coverLastErrorCode    String?
  coverLastErrorMessage String?             @db.Text
  task                  AiSearchTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parentCandidate       ResearchCandidate?  @relation("ResearchCandidateHierarchy", fields: [parentCandidateId], references: [id], onDelete: SetNull)
  childCandidates       ResearchCandidate[] @relation("ResearchCandidateHierarchy")
  work                  ReleaseWork?        @relation(fields: [workId], references: [id], onDelete: SetNull)
  release               Release?            @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  decisions             ResearchDecision[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([taskId, candidateKey])
  @@index([taskId, disposition, lastStage])
  @@index([parentCandidateId])
  @@index([workId])
  @@index([releaseId])
  @@index([coverStatus, coverNextRetryAt])
}

model ResearchDecision {
  id             String                  @id @default(cuid())
  candidateId    String
  sequence       Int
  attempt        Int                     @default(1)
  stage          String
  outcome        ResearchDecisionOutcome
  reasonCode     String
  reasonText     String?                 @db.Text
  retryable      Boolean                 @default(false)
  sourceProvider String?
  evidence       Json?
  candidate      ResearchCandidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt      DateTime                @default(now())

  @@unique([candidateId, sequence])
  @@index([candidateId, stage])
  @@index([stage, outcome, reasonCode])
}

model ResearchStageSummary {
  id              String       @id @default(cuid())
  taskId          String
  stage           String
  sequence        Int
  inputCount      Int          @default(0)
  passedCount     Int          @default(0)
  deferredCount   Int          @default(0)
  rejectedCount   Int          @default(0)
  mergedCount     Int          @default(0)
  retryCount      Int          @default(0)
  reasonCounts    Json?
  detailsComplete Boolean      @default(true)
  startedAt       DateTime?
  completedAt     DateTime?
  task            AiSearchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([taskId, stage])
  @@unique([taskId, sequence])
}

model UiAsset {
  id        String      @id @default(cuid())
  userId    String?
  kind      UiAssetKind
  prompt    String      @db.Text
  model     String
  imageUrl  String?     @db.Text
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}
